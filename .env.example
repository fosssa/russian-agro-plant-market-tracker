# Environment Configuration Template
# Copy this file to .env and adjust values as needed

# ============================================
# Deployment / CI (used by production compose and pipelines)
# ============================================
DEPLOY_HOST=                # Target host/IP for deployments (used by CI)
DEPLOY_USER=                # SSH username for DEPLOY_HOST
DEPLOY_SSH_KEY=             # Private SSH key contents for CI deploys
CI_REGISTRY_IMAGE=          # Registry path for built images (CI provided)
DEPLOY_TAG=latest           # Image tag to deploy (CI default: latest)

# ============================================
# Backend Runtime
# ============================================
DATABASE_URL=sqlite:////app/data/app.db   # SQLAlchemy DB URL (SQLite default)
UVICORN_ROOT_PATH=                        # Prefix when behind a reverse proxy
WORKERS=1                                 # Uvicorn worker count
LOG_LEVEL=info                            # Uvicorn log level (debug/info/warning/error/critical)

# ============================================
# Frontend Runtime
# ============================================
VITE_API_BASE_URL=http://backend:7000     # Frontend -> backend API base URL
VITE_API_TIMEOUT=10000                    # Axios timeout in ms
# HTTP Basic Authentication credentials for frontend access
BASIC_AUTH_USER=admin                     # Basic auth username
BASIC_AUTH_PASSWORD=changeme              # Basic auth password